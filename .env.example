# Required: Your Telegram Bot Token obtained from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: Translation Provider ('mymemory' or 'deepl')
# Default is 'mymemory' which works for free without any API key!
TRANSLATION_PROVIDER=mymemory

# Optional: DeepL API Key (if TRANSLATION_PROVIDER=deepl)
# Free keys end with ':fx', e.g. from https://www.deepl.com/pro-api
DEEPL_API_KEY=

# Optional: Email for MyMemory (increases daily free limit to 50,000 words/day)
MYMEMORY_EMAIL=

# Mode: 'forwarded_only' (only translate forwarded messages) or 'all' (translate direct and forwarded messages)
BOT_MODE=forwarded_only

